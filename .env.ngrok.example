# ngrok 本地联调覆盖层模板。
# 用法：./scripts/run_ngrok_local.sh —— 缺失时自动复制本文件为 .env.ngrok，并把隧道
# 域名回写进 H5_BASE_URL / WECHAT_OAUTH_REDIRECT_URI / WECHATPAY_NOTIFY_BASE_URL /
# TRUSTED_HOSTS / CORS_ORIGINS 五项。
# 本文件是本机 API、wechat-pay-worker 进程的配置覆盖层，覆盖根目录 .env，
# 因此不必反复手改 .env；删掉本文件即回到纯本机 development 模式。
# 这不是生产环境，禁止用于正式资金活动，也禁止把真实密钥提交进仓库。

APP_NAME=Betel Lottery API
# staging 会启用真实公众号 OAuth，并拒绝 dev-login/wechat-login 伪造 OpenID；
# AppID/AppSecret 留空时 oauth_enabled=false，H5 自动退回 dev-login 预览。
ENVIRONMENT=staging

# 本机直连 MySQL/Redis（端口和口令按宿主机实际配置填写）
# 用于 scripts/backup_mysql.sh 的数据库备份连接信息
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=betel_lottery
MYSQL_USER=root
MYSQL_PASSWORD=root123456
DATABASE_URL=mysql+pymysql://root:root123456@127.0.0.1:3306/betel_lottery?charset=utf8mb4
REDIS_URL=redis://:redis123456@127.0.0.1:6379/0

JWT_SECRET=replace-with-a-long-random-staging-secret
# 隧道下 H5 与 API 同域、SPA 挂在根路径：这里不能带 /scan 之类子路径，否则 JS-SDK
# 签名校验与 OAuth 回跳都会 404。脚本会自动写入真实域名。
H5_BASE_URL=https://YOUR_NGROK_DOMAIN

# 隧道会把 /api/admin/auth/login 暴露到公网，必须改掉默认口令
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-staging-password

CORS_ORIGINS=https://YOUR_NGROK_DOMAIN,http://localhost:5173,http://localhost:5174,http://localhost:5175
TRUSTED_HOSTS=YOUR_NGROK_DOMAIN,localhost,127.0.0.1
# TLS 在 ngrok 边缘终止，API 只收到 http，这里必须保持 false：
# FORCE_HTTPS=true 会让 HTTPSRedirectMiddleware 把代理转发的 /api 请求重定向成 127.0.0.1 而死循环。
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=true
PERSONAL_DATA_RETENTION_DAYS=730
# TIANDITU_API_KEY=...  不写这一行则继承 .env；写成空值会关闭坐标归属地解析

# ===== 微信公众号 OAuth =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_SCOPE=snsapi_base
WECHAT_OAUTH_REDIRECT_URI=https://YOUR_NGROK_DOMAIN/api/h5/auth/wechat/callback

# ===== 微信支付商家转账 =====
# 只测 OAuth/抽奖时保持 false；要联调真实现金再填下列值，并把两份 PEM 放进
# 宿主机密钥目录中的两份 PEM 文件。
WECHATPAY_ENABLED=false
WECHATPAY_MCHID=
WECHATPAY_MCH_SERIAL_NO=
WECHATPAY_MCH_PRIVATE_KEY_PATH=./secrets/wechatpay/apiclient_key.pem
WECHATPAY_MCH_PUBLIC_KEY_ID=
WECHATPAY_MCH_PUBLIC_KEY_PATH=./secrets/wechatpay/wechatpay_public_key.pem
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_BASE_URL=https://YOUR_NGROK_DOMAIN
WECHATPAY_SCENE_ID=1000
WECHATPAY_BILL_NAME=槟郎开袋有礼
WECHATPAY_BILL_REMARK_PREFIX=扫码抽奖现金奖励
WECHATPAY_MAX_ATTEMPTS=8
WECHATPAY_CONFIRM_TIMEOUT_MINUTES=4320
WECHATPAY_WORKER_POLL_SECONDS=5
WECHATPAY_WORKER_BATCH_SIZE=20
