APP_NAME=Betel Lottery API
ENVIRONMENT=development
# 本机运行 API、worker、脚本和 IDE 使用下面两条连接串
DATABASE_URL=mysql+pymysql://root:root123456@127.0.0.1:3306/betel_lottery?charset=utf8mb4
REDIS_URL=redis://:redis123456@127.0.0.1:6379/0
# Optional scripts/backup_mysql.sh connection settings
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=betel_lottery
MYSQL_USER=root
MYSQL_PASSWORD=root123456
JWT_SECRET=replace-with-a-long-random-secret
H5_BASE_URL=https://example.com/scan
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
# 三个前端 dev 端口：admin 5173 / h5 5174 / dealer 5175
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
# 反向代理/ngrok 联调时解析 X-Forwarded-For 真实客户端 IP（仅当直连对端是回环/内网时生效）
# API 端口直接暴露公网时必须设为 false
TRUST_PROXY_HEADERS=true
PERSONAL_DATA_RETENTION_DAYS=730
TIANDITU_API_KEY=your-tianditu-api-key
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_SCOPE=snsapi_base
# 反向代理/隧道场景必须显式配置，域名要与微信后台「网页授权域名」一致且路径为回调路由
WECHAT_OAUTH_REDIRECT_URI=

# ===== 微信公众号 / 微信支付商家转账（新版 /v3/fund-app/mch-transfer）=====
# 生产启用后才允许自动创建转账单并拉起“用户微信确认收款”。开发环境保持 false：
# MVP 已移除人工登记现金入口，false 时现金奖只会停在“待领取”，不会错误放款。
# 切勿把真实 AppSecret / APIv3 Key / 私钥写入仓库。
WECHATPAY_ENABLED=false
# 商户号（需开通“商家转账”产品并完成现金营销场景 1000 审核）
WECHATPAY_MCHID=
# 商户 API 证书序列号（商户平台 → API 安全 → APIv3）
WECHATPAY_MCH_SERIAL_NO=
# 宿主机上的密钥目录；请将目录权限限制为运行服务的账号可读。
WECHATPAY_SECRET_DIR=./secrets/wechatpay
# 商户 API 私钥 PEM 文件路径（勿提交仓库）
WECHATPAY_MCH_PRIVATE_KEY_PATH=./secrets/wechatpay/apiclient_key.pem
# 微信支付平台公钥 ID 与文件路径，用于验签回调及响应。这里不是商户证书：
# 在商户平台“API 安全 → 微信支付平台证书/平台公钥”下载并填写，轮换时需同步更新两项。
WECHATPAY_MCH_PUBLIC_KEY_ID=
WECHATPAY_MCH_PUBLIC_KEY_PATH=./secrets/wechatpay/wechatpay_public_key.pem
# 32 位 APIv3 密钥，用于 AES-256-GCM 解密回调资源
WECHATPAY_API_V3_KEY=
# 公网 HTTPS 无路径基址；最终回调为 {WECHATPAY_NOTIFY_BASE_URL}/api/wechat-pay/notify
# 生产环境必须显式填写，不能依赖 H5_BASE_URL 推导
WECHATPAY_NOTIFY_BASE_URL=https://example.com
# 转账单商户单号与场景配置（一般无需修改）
WECHATPAY_SCENE_ID=1000
WECHATPAY_BILL_NAME=槟郎开袋有礼
WECHATPAY_BILL_REMARK_PREFIX=扫码抽奖现金奖励
# 同一笔现金奖最多换新商户单号的次数（撤销后用户重领等场景）；达到后只能人工处理
WECHATPAY_MAX_ATTEMPTS=8
# WAIT_USER_CONFIRM 超时未确认自动撤销的分钟数（微信默认确认页有效期为 72 小时）
WECHATPAY_CONFIRM_TIMEOUT_MINUTES=4320
# 定时打款 worker 参数（本机常驻进程或 cron 均可）
WECHATPAY_WORKER_POLL_SECONDS=5
WECHATPAY_WORKER_BATCH_SIZE=20
# 仅旧版 /api/admin/cash-payments/callback 使用的共享密钥；新微信回调不依赖此项
PAYMENT_CALLBACK_SECRET=
